# FreelancePilot – dokumentované environment premenné
# Skopíruj do .env a doplň skutočné hodnoty. .env sa NEcommituje.

# PostgreSQL
POSTGRES_DB=freelancepilot
POSTGRES_USER=freelancepilot
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=freelancepilot

# Backend (BFF)
BACKEND_PORT=8080
OIDC_ISSUER_URI=http://localhost:8081/realms/freelancepilot
OIDC_CLIENT_ID=freelancepilot-bff
OIDC_CLIENT_SECRET=changeme

# Frontend
FRONTEND_PORT=5173
# Base URL backendu pre frontend build (default /api cez Vite proxy / reverse proxy)
VITE_API_BASE_URL=/api